---
// Frontmatter: plain JavaScript comments

// imports
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookCard from "../../components/BookCard.astro";
import { getCollection } from "astro:content";

// An interface is a TypeScript feature, not something specific to Astro. It describes the shape of an object: which properties it has and what type each one is. It’s a contract that says what data is expected.
// defines the books inside this component
// now done in the collection
// interface Book {
//   title: string;
//   author: string;
// }

// define books data
// an array of book objects made according to the book interface
// normally you would fetch data from an api or use astro's content collections
// const books: Book[] = [
//   { title: "The Name of The Wind", author: "Patrick Rothfuss" },
//   { title: "The Final Empire", author: "Brandon Sanderson" },
//   { title: "The Blade Itself", author: "Joe Abercrombie" },
//   { title: "The Will of the Many", author: "James Islington" },
// ];

// get the collection of json data that was defined in the content.config file
// pass in the name of the collection you want to return
// astro will use this books collection that you defined to load the data and bring it into this component
// this will be an array of book object entries
const books = await getCollection("books");
---

<BaseLayout>
  {/* Stripped from the build. Use this for notes to yourself */}
  <!-- Kept in the HTML. Anyone can see this in the page source -->
  <div class="content">
    <h2>Books</h2>

    <!-- map through the books array and display a div for each one (fires a function for each one) -->
    <!-- as an argument to that callback function, you get access to the individual book youre currently iterating through-->
    <!-- outputting a list of data -->
    <!-- astro doesnt need a key property because it doesnt need to keep track of the list in the browser -->
    <!-- its all rendered at build time -->
    {books.map((book) => (
      // BookCark component
      // a properrty passed into the BookCard component
      // iterates through the books in the book array of objects
      <BookCard book={book} />
    ))}

    <!-- conditionally output a message when there are no books in the array -->
    <!-- add curly braces for a dynamic expression -->
    <!-- the right side of the expression runs only if the left side is true -->
    {books.length < 1 && <p>No books to show.</p>}
  </div>
  <!-- end .content div -->
</BaseLayout>
